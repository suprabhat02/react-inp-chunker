{
  "name": "react-inp-chunker",
  "version": "0.2.0",
  "description": "Headless React/TypeScript primitives that chunk heavy synchronous work and yield to the main thread, so long-running updates never cost you Interaction to Next Paint (INP).",
  "keywords": [
    "react",
    "typescript",
    "inp",
    "interaction-to-next-paint",
    "core-web-vitals",
    "performance",
    "scheduler",
    "scheduler.yield",
    "main-thread",
    "concurrent",
    "headless"
  ],
  "homepage": "https://suprabhat02.github.io/react-inp-chunker/",
  "bugs": "https://github.com/suprabhat02/react-inp-chunker/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suprabhat02/react-inp-chunker.git"
  },
  "license": "MIT",
  "author": "Suprabhat Kumar (https://suprabhat-dev.com)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "production": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/production/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/production/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "production": {
        "import": {
          "types": "./dist/core/index.d.ts",
          "default": "./dist/production/core/index.js"
        },
        "require": {
          "types": "./dist/core/index.d.cts",
          "default": "./dist/production/core/index.cjs"
        }
      },
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "core",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:react18": "tsc -p tsconfig.react18.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run api:check && npm run lint:package && npm run types:resolution && npm run types:consumer && npm run size",
    "prepublishOnly": "npm run verify",
    "bench": "npm run build && node bench/overhead.mjs",
    "api:check": "node scripts/api-surface.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "lint:package": "publint --strict",
    "types:resolution": "node scripts/check-type-resolution.mjs",
    "types:consumer": "tsc -p consumer/tsconfig.bundler.json && tsc -p consumer/tsconfig.nodenext.json",
    "test:browser": "npm run build && node tests/browser/yielding.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.5.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "publint": "^0.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "size-limit": [
    {
      "name": "core (import { createChunkScheduler })",
      "path": "dist/production/core/index.js",
      "import": "{ createChunkScheduler }",
      "limit": "1.4 kB"
    },
    {
      "name": "useChunkedTask",
      "path": "dist/production/index.js",
      "import": "{ useChunkedTask }",
      "limit": "2.2 kB"
    },
    {
      "name": "useDeferredTask",
      "path": "dist/production/index.js",
      "import": "{ useDeferredTask }",
      "limit": "1.8 kB"
    },
    {
      "name": "everything",
      "path": "dist/production/index.js",
      "limit": "3.5 kB"
    }
  ]
}
